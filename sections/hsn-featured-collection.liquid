<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Outfit:wght@100..900&display=swap">
{% comment %}
  HSN Featured Collection — product grid with hover image, badges, quick add.
  Settings groups: Content, Layout, Colors, Product card. Blocks: none (uses collection).
{% endcomment %}

{%- liquid
  assign collection = collections[section.settings.collection]
  assign on_sale = false
  assign products_to_show = section.settings.products_to_show
-%}

<div
  id="{{ section.id }}"
  class="hsn-collection section-{{ section.id }}"
  style="--cl-pt: {{ section.settings.padding_top }}px; --cl-pb: {{ section.settings.padding_bottom }}px; --cl-cols-d: {{ section.settings.columns_desktop }}; --cl-cols-m: {{ section.settings.columns_mobile }}; --cl-accent-text: {{ section.settings.accent_text }};"
  {{ section.shopify_attributes }}
>
  <div class="hsn-collection__wrap{% unless section.settings.full_width %} hsn-collection--page-width{% endunless %}">
    {%- if section.settings.heading != blank -%}
      <h2 class="hsn-collection__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}

    <div class="hsn-collection__grid">
      {%- if collection != blank -%}
        {%- for product in collection.products limit: products_to_show -%}
          {%- liquid
            assign on_sale = false
            if product.compare_at_price > product.price
              assign on_sale = true
            endif
            assign second_image = product.images[1]
          -%}
          <article class="hsn-card" data-hsn-product-card>
            <a class="hsn-card__media" href="{{ product.url }}" aria-label="{{ product.title | escape }}">
              {%- if section.settings.show_badge -%}
                {%- if product.available == false -%}
                  <span class="hsn-card__flag">Sold out</span>
                {%- elsif on_sale -%}
                  <span class="hsn-card__flag">Sale</span>
                {%- elsif product.tags contains section.settings.badge_tag -%}
                  <span class="hsn-card__flag">{{ section.settings.badge_tag | escape }}</span>
                {%- endif -%}
              {%- endif -%}
              {%- if product.featured_image -%}
                {{ product.featured_image | image_url: width: 900 | image_tag: widths: '300, 450, 600, 900', sizes: '(min-width: 1100px) 23vw, (min-width: 800px) 45vw, 70vw', alt: product.featured_image.alt | default: product.title, loading: 'lazy', decoding: 'async' }}
                {%- if section.settings.hover_image and second_image -%}
                  {{ second_image | image_url: width: 900 | image_tag: widths: '300, 450, 600, 900', sizes: '(min-width: 1100px) 23vw, (min-width: 800px) 45vw, 70vw', alt: '', loading: 'lazy', decoding: 'async', class: 'hsn-card__img-alt' }}
                {%- endif -%}
              {%- else -%}
                {{ 'product-1' | placeholder_svg_tag: 'hsn-card__placeholder' }}
              {%- endif -%}
            </a>

            <div class="hsn-card__info">
              {%- if section.settings.show_rating and product.metafields.reviews.rating.value != blank -%}
                {%- assign rating = product.metafields.reviews.rating.value -%}
                <div class="hsn-card__rate" role="img" aria-label="{{ rating.rating }} out of 5 stars">
                  {%- for i in (1..5) -%}
                    <span class="hsn-card__star{% if i > rating.rating %} hsn-card__star--off{% endif %}" aria-hidden="true">&#9733;</span>
                  {%- endfor -%}
                </div>
              {%- endif -%}

              <h3 class="hsn-card__name"><a href="{{ product.url }}">{{ product.title | escape }}</a></h3>
              {%- if section.settings.show_vendor and product.vendor != blank -%}
                <p class="hsn-card__vendor">{{ product.vendor | escape }}</p>
              {%- endif -%}

              <div class="hsn-card__price">
                {%- if product.compare_at_price > product.price -%}
                  <span class="hsn-card__price-now">{{ product.price | money }}</span>
                  <s class="hsn-card__price-was">{{ product.compare_at_price | money }}</s>
                {%- else -%}
                  <span class="hsn-card__price-now">{{ product.price | money }}</span>
                {%- endif -%}
              </div>

              {%- if product.available -%}
                {%- if product.variants.size == 1 -%}
                  {%- form 'product', product, class: 'hsn-card__form' -%}
                    <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                    <input type="hidden" name="quantity" value="1">
                    <button type="submit" class="hsn-card__add">{{ section.settings.add_label | escape }}</button>
                  {%- endform -%}
                {%- else -%}
                  <a class="hsn-card__add" href="{{ product.url }}">{{ section.settings.choose_label | escape }}</a>
                {%- endif -%}
              {%- else -%}
                <button type="button" class="hsn-card__add" disabled>Sold out</button>
              {%- endif -%}
            </div>
          </article>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..4) -%}
          <article class="hsn-card" data-hsn-product-card>
            <a class="hsn-card__media" href="{{ routes.all_products_collection_url }}" aria-hidden="true" tabindex="-1">
              {{ 'product-' | append: i | placeholder_svg_tag: 'hsn-card__placeholder' }}
            </a>
            <div class="hsn-card__info">
              <h3 class="hsn-card__name">{{ 'Example product title' | escape }}</h3>
              <div class="hsn-card__price"><span class="hsn-card__price-now">{{ 1999 | money }}</span></div>
              <button type="button" class="hsn-card__add" disabled>{{ section.settings.add_label | escape }}</button>
            </div>
          </article>
        {%- endfor -%}
      {%- endif -%}
    </div>

    {%- if section.settings.show_cta -%}
      <div class="hsn-collection__cta">
        <a class="hsn-collection__btn" href="{{ collection.url | default: routes.all_products_collection_url }}">
          {{ section.settings.cta_label | escape }}
          <svg class="hsn-collection__btn-ar" width="15" height="12" viewBox="0 0 16 12" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M1 6h13M9.6 1.4 14.2 6l-4.6 4.6"/></svg>
        </a>
      </div>
    {%- endif -%}
  </div>
</div>

{% style %}
  @font-face{font-family:'PP Monument Extended';src:url('https://cdn.shopify.com/s/files/1/0910/7564/1730/files/PPMonumentExtended-Bold.woff?v=1767889659') format('woff');font-weight:700;font-style:normal;font-display:swap}
  @font-face{font-family:'PP Monument Extended';src:url('https://cdn.shopify.com/s/files/1/0910/7564/1730/files/PPMonumentExtended-Regular.woff?v=1767889658') format('woff');font-weight:400;font-style:normal;font-display:swap}
  .section-{{ section.id }} .hsn-collection__wrap {
    padding-block: var(--cl-pt) var(--cl-pb);
    padding-inline: clamp(16px, 4.4vw, 72px);
  }
  .section-{{ section.id }} .hsn-collection--page-width {
    max-width: 1400px;
    margin-inline: auto;
  }
  .section-{{ section.id }} .hsn-collection__heading {
    font-family: 'PP Monument Extended', 'Archivo', system-ui, sans-serif;
    font-weight: 700;
    font-size: clamp(22px, 3vw, 40px);
    text-transform: uppercase;
    color: #000;
    margin: 0 0 clamp(20px, 3vw, 36px);
  }
  .section-{{ section.id }} .hsn-collection__grid {
    display: grid;
    grid-template-columns: repeat(var(--cl-cols-d), minmax(0, 1fr));
    gap: clamp(16px, 1.8vw, 26px);
  }
  .section-{{ section.id }} .hsn-card {
    display: flex;
    flex-direction: column;
    background: #f4f4f2;
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: 8px;
    overflow: hidden;
    transition: box-shadow 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .section-{{ section.id }} .hsn-card:hover {
    box-shadow: 0 20px 44px rgba(0, 0, 0, 0.09);
  }
  .section-{{ section.id }} .hsn-card__media {
    position: relative;
    display: block;
    aspect-ratio: 1 / 1;
    margin: 12px 12px 0;
    border-radius: 10px;
    overflow: hidden;
    background: #f1f1ef;
  }
  .section-{{ section.id }} .hsn-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .section-{{ section.id }} .hsn-card:hover .hsn-card__media img {
    transform: scale(1.05);
  }
  .section-{{ section.id }} .hsn-card__img-alt {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .section-{{ section.id }} .hsn-card:hover .hsn-card__img-alt {
    opacity: 1;
  }
  .section-{{ section.id }} .hsn-card__placeholder,
  .section-{{ section.id }} .hsn-card__media svg {
    width: 100%;
    height: 100%;
    opacity: 0.4;
  }
  .section-{{ section.id }} .hsn-card__flag {
    position: absolute;
    top: 14px;
    right: 14px;
    z-index: 2;
    background: #7eb8d4;
    color: #000;
    font-family: 'Outfit', 'Archivo', system-ui, sans-serif;
    font-size: 10px;
    font-weight: 750;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    padding: 6px 12px;
    border-radius: 3px;
  }
  .section-{{ section.id }} .hsn-card__info {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 18px 20px 20px;
    min-width: 0;
  }
  .section-{{ section.id }} .hsn-card__rate {
    color: #3e7ea0;
    font-size: 12px;
    letter-spacing: 2px;
    margin-bottom: 10px;
  }
  .section-{{ section.id }} .hsn-card__star--off {
    opacity: 0.25;
  }
  .section-{{ section.id }} .hsn-card__name {
    font-family: 'PP Monument Extended', 'Archivo', system-ui, sans-serif;
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    line-height: 1.35;
    margin: 0 0 8px;
  }
  .section-{{ section.id }} .hsn-card__name a {
    color: #000;
  }
  .section-{{ section.id }} .hsn-card__vendor {
    font-size: 12px;
    color: #8a8a8a;
    margin: 0 0 8px;
  }
  .section-{{ section.id }} .hsn-card__price {
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin: 0 0 16px;
  }
  .section-{{ section.id }} .hsn-card__price-now {
    font-family: 'Outfit', 'Archivo', system-ui, sans-serif;
    font-weight: 700;
    font-size: 15px;
    color: #000;
  }
  .section-{{ section.id }} .hsn-card__price-was {
    font-size: 13px;
    color: #9a9a9a;
  }
  .section-{{ section.id }} .hsn-card__add {
    margin-top: auto;
    width: 100%;
    min-height: 46px;
    color: #000;
    background-image: linear-gradient(to right, #000 50%, #7eb8d4 50%);
    background-size: 200% 100%;
    background-position: 100% 0;
    border: 0;
    border-radius: 3px;
    cursor: pointer;
    font-family: 'Outfit', 'Archivo', system-ui, sans-serif;
    font-size: 11.5px;
    line-height: 1;
    font-weight: 650;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-align: center;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: background-position 0.5s cubic-bezier(0.16, 1, 0.3, 1), color 0.35s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.2s;
  }
  .section-{{ section.id }} .hsn-card__add:hover:not([disabled]),
  .section-{{ section.id }} .hsn-card__add:focus-visible {
    background-position: 0 0;
    color: #fff;
  }
  .section-{{ section.id }} .hsn-card__add[disabled] {
    opacity: 0.45;
    cursor: not-allowed;
  }
  .section-{{ section.id }} .hsn-card__form {
    margin: 0;
  }
  .section-{{ section.id }} .hsn-collection__cta {
    display: flex;
    justify-content: center;
    margin-top: clamp(34px, 4vw, 54px);
  }
  .section-{{ section.id }} .hsn-collection__btn {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    background: #000;
    color: #fff;
    font-family: 'Outfit', 'Archivo', system-ui, sans-serif;
    font-size: 12px;
    line-height: 1;
    font-weight: 650;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    padding: 18px 34px;
    border-radius: 3px;
    transition: background 0.2s cubic-bezier(0.4, 0, 0.2, 1), color 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .section-{{ section.id }} .hsn-collection__btn:hover,
  .section-{{ section.id }} .hsn-collection__btn:focus-visible {
    background: #7eb8d4;
    color: #000;
  }
  .section-{{ section.id }} :is(a, button):focus-visible {
    outline: 2px solid var(--cl-accent-text, #3e7ea0);
    outline-offset: 2px;
  }
  @media (max-width: 1100px) {
    .section-{{ section.id }} .hsn-collection__grid {
      grid-template-columns: repeat(var(--cl-cols-m), minmax(0, 1fr));
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "HSN Featured Collection",
  "tag": "section",
  "class": "hsn-collection-section",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Best sellers" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "products_to_show", "label": "Products to show", "min": 2, "max": 12, "step": 1, "default": 4 },
    { "type": "text", "id": "add_label", "label": "Add to cart label", "default": "Add to cart" },
    { "type": "text", "id": "choose_label", "label": "Choose options label", "default": "Choose options" },
    { "type": "header", "content": "Call to action" },
    { "type": "checkbox", "id": "show_cta", "label": "Show button below grid", "default": true },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Shop All" },
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "columns_desktop", "label": "Columns (desktop)", "min": 2, "max": 5, "step": 1, "default": 4 },
    { "type": "select", "id": "columns_mobile", "label": "Columns (mobile)", "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ], "default": "2" },
    { "type": "checkbox", "id": "full_width", "label": "Full page width", "default": false },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 140, "step": 4, "unit": "px", "default": 100 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 140, "step": 4, "unit": "px", "default": 80 },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "accent_text", "label": "Focus accent", "default": "#3E7EA0" },
    { "type": "header", "content": "Product card" },
    { "type": "checkbox", "id": "hover_image", "label": "Show second image on hover", "default": true },
    { "type": "checkbox", "id": "show_badge", "label": "Show badges", "default": true },
    { "type": "text", "id": "badge_tag", "label": "Featured badge tag", "info": "Products with this tag show a black badge. Sale and sold-out badges are automatic.", "default": "best seller" },
    { "type": "checkbox", "id": "show_rating", "label": "Show star rating", "info": "Appears only when the product has a reviews rating metafield.", "default": true },
    { "type": "checkbox", "id": "show_vendor", "label": "Show vendor", "default": false }
  ],
  "presets": [
    { "name": "HSN Featured Collection" }
  ]
}
{% endschema %}
