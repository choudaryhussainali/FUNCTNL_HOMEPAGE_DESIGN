{% comment %}
  FX Social Grid — community image wall. Groups: Content, Layout, Colors, Spacing. Blocks: tile.
{% endcomment %}

<div
  id="{{ section.id }}"
  class="fx-social section-{{ section.id }}"
  style="--so-pt: {{ section.settings.padding_top }}px; --so-pb: {{ section.settings.padding_bottom }}px; --so-accent: {{ section.settings.accent }};"
  {{ section.shopify_attributes }}
>
  <div class="fx-social__in">
    {%- if section.settings.pill != blank -%}
      <span class="fx-social__pill">{{ section.settings.pill | escape }}</span>
    {%- endif -%}
    <h2 class="fx-social__heading">
      {{ section.settings.heading | escape }}
      {%- if section.settings.handle_link != blank and section.settings.handle_text != blank -%}
        <a href="{{ section.settings.handle_link }}">{{ section.settings.handle_text | escape }}</a>
      {%- endif -%}
    </h2>
    <div class="fx-social__grid">
      {%- for block in section.blocks -%}
        <div class="fx-social__tile" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 600 | image_tag: widths: '200, 300, 450, 600', sizes: '(min-width: 861px) 18vw, 45vw', alt: block.settings.alt | escape, loading: 'lazy', decoding: 'async' }}
          {%- else -%}
            {{ 'image' | placeholder_svg_tag: 'fx-social__placeholder' }}
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% style %}
  .section-{{ section.id }} .fx-social {
    background: #fff;
    border-top: 1px solid rgba(0, 0, 0, 0.1);
    padding-block: var(--so-pt) var(--so-pb);
  }
  .section-{{ section.id }} .fx-social__in {
    max-width: 1400px;
    margin-inline: auto;
    padding-inline: clamp(16px, 4.4vw, 72px);
    display: flex;
    flex-direction: column;
    align-items: center;
    box-sizing: border-box;
  }
  .section-{{ section.id }} .fx-social__pill {
    display: inline-block;
    border: 1px solid rgba(0, 0, 0, 0.22);
    border-radius: 999px;
    font-family: 'Outfit', 'Archivo', system-ui, sans-serif;
    font-size: 11px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(0, 0, 0, 0.6);
    padding: 9px 18px;
    margin-bottom: 20px;
  }
  .section-{{ section.id }} .fx-social__heading {
    font-family: 'PP Monument Extended', 'Archivo', system-ui, sans-serif;
    font-weight: 700;
    font-size: clamp(20px, 2.8vw, 34px);
    color: #000;
    text-align: center;
    margin: 0 0 clamp(28px, 4vw, 46px);
  }
  .section-{{ section.id }} .fx-social__heading a {
    color: var(--so-accent);
    border-bottom: 2px solid var(--so-accent);
    padding-bottom: 2px;
  }
  .section-{{ section.id }} .fx-social__grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: clamp(8px, 1.2vw, 18px);
    width: 100%;
  }
  .section-{{ section.id }} .fx-social__tile {
    border-radius: 8px;
    overflow: hidden;
    aspect-ratio: 1 / 1.06;
    background: #f1f1ef;
  }
  .section-{{ section.id }} .fx-social__tile img,
  .section-{{ section.id }} .fx-social__tile .fx-social__placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .section-{{ section.id }} .fx-social__tile .fx-social__placeholder {
    opacity: 0.4;
  }
  @media (max-width: 860px) {
    .section-{{ section.id }} .fx-social__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .section-{{ section.id }} .fx-social__tile:nth-child(5) { display: none; }
  }
{% endstyle %}

{% schema %}
{
  "name": "FX Social Grid",
  "tag": "section",
  "class": "fx-social-section",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "pill", "label": "Pill text", "default": "40k+ Community" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Follow us" },
    { "type": "text", "id": "handle_text", "label": "Handle text", "default": "@functnl" },
    { "type": "url", "id": "handle_link", "label": "Handle link" },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "accent", "label": "Accent", "default": "#3E7EA0" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 20, "max": 140, "step": 4, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 20, "max": 140, "step": 4, "unit": "px", "default": 96 }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Image tile",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "alt", "label": "Image alt text", "default": "Community post" }
      ]
    }
  ],
  "max_blocks": 5,
  "presets": [
    {
      "name": "FX Social Grid",
      "blocks": [
        { "type": "tile" },
        { "type": "tile" },
        { "type": "tile" },
        { "type": "tile" },
        { "type": "tile" }
      ]
    }
  ]
}
{% endschema %}
