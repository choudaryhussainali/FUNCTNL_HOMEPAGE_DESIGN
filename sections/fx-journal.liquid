{% comment %}
  FX Journal — article cards from a blog. Groups: Content, Layout, Colors, Spacing.
{% endcomment %}

<div
  id="{{ section.id }}"
  class="fx-journal section-{{ section.id }}"
  style="--jl-pt: {{ section.settings.padding_top }}px; --jl-pb: {{ section.settings.padding_bottom }}px; --jl-accent: {{ section.settings.accent }};"
  {{ section.shopify_attributes }}
>
  <div class="fx-journal__wrap">
    <div class="fx-journal__top">
      <div>
        <span class="fx-journal__eyebrow">{{ section.settings.eyebrow | escape }}</span>
        <h2 class="fx-journal__heading">{{ section.settings.heading | escape }}</h2>
      </div>
      <div class="fx-journal__nav">
        <button type="button" class="fx-journal__circ" data-fx-journal-role="prev" aria-label="Scroll back">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 5l-7 7 7 7"/></svg>
        </button>
        <button type="button" class="fx-journal__circ" data-fx-journal-role="next" aria-label="Scroll forward">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg>
        </button>
      </div>
    </div>

    <div class="fx-journal__track" data-fx-journal-role="track">
      {%- if section.settings.blog != blank -%}
        {%- for article in section.settings.blog.articles limit: section.settings.posts_to_show -%}
          <article class="fx-jcard">
            <a href="{{ article.url }}" class="fx-jcard__media" aria-hidden="true" tabindex="-1">
              {%- if article.image -%}
                {{ article.image | image_url: width: 800 | image_tag: widths: '340, 500, 800', sizes: '(min-width: 1101px) 22vw, 78vw', alt: '', loading: 'lazy', decoding: 'async' }}
              {%- else -%}
                {{ 'image' | placeholder_svg_tag: 'fx-jcard__placeholder' }}
              {%- endif -%}
            </a>
            <div class="fx-jcard__body">
              <p class="fx-jcard__meta">
                {{ article.published_at | date: format: 'abbreviated_date' }}
                {%- if article.author != blank %} &bull; <em>{{ article.author | escape }}</em>{% endif -%}
              </p>
              <h3 class="fx-jcard__title"><a href="{{ article.url }}">{{ article.title | escape }}</a></h3>
              {%- if article.excerpt != blank -%}
                <p class="fx-jcard__excerpt">{{ article.excerpt | strip_html | truncate: 120 | escape }}</p>
              {%- endif -%}
              <a href="{{ article.url }}" class="fx-jcard__read">Read
                <svg width="15" height="12" viewBox="0 0 16 12" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M1 6h13M9.6 1.4 14.2 6l-4.6 4.6"/></svg>
              </a>
            </div>
          </article>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..4) -%}
          <article class="fx-jcard">
            <div class="fx-jcard__media" aria-hidden="true">
              {{ 'image' | append: i | placeholder_svg_tag: 'fx-jcard__placeholder' }}
            </div>
            <div class="fx-jcard__body">
              <p class="fx-jcard__meta">{{ 'today' | date: format: 'abbreviated_date' }}</p>
              <h3 class="fx-jcard__title">{{ 'Example journal article title' | escape }}</h3>
              <p class="fx-jcard__excerpt">{{ 'A short excerpt of the article appears here once content is added.' | escape }}</p>
              <span class="fx-jcard__read">Read</span>
            </div>
          </article>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</div>

{% style %}
  .section-{{ section.id }} .fx-journal {
    background: #000;
    color: #fff;
    padding-block: var(--jl-pt) var(--jl-pb);
  }
  .section-{{ section.id }} .fx-journal__wrap {
    max-width: 1400px;
    margin-inline: auto;
    padding-inline: clamp(16px, 4.4vw, 72px);
    box-sizing: border-box;
  }
  .section-{{ section.id }} .fx-journal__top {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    padding-top: clamp(26px, 3vw, 40px);
    margin-bottom: clamp(28px, 3.5vw, 46px);
  }
  .section-{{ section.id }} .fx-journal__eyebrow {
    display: block;
    font-family: 'Outfit', 'Archivo', system-ui, sans-serif;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--jl-accent);
    margin-bottom: 14px;
  }
  .section-{{ section.id }} .fx-journal__heading {
    font-family: 'PP Monument Extended', 'Archivo', system-ui, sans-serif;
    font-weight: 700;
    font-size: clamp(24px, 3.2vw, 42px);
    line-height: 1.15;
    color: #fff;
    margin: 0;
  }
  .section-{{ section.id }} .fx-journal__nav {
    display: flex;
    gap: 12px;
    flex: none;
  }
  .section-{{ section.id }} .fx-journal__circ {
    width: 46px;
    height: 46px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.3);
    background: none;
    color: #fff;
    display: grid;
    place-items: center;
    cursor: pointer;
    transition: background 0.2s cubic-bezier(0.4, 0, 0.2, 1), color 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .section-{{ section.id }} .fx-journal__circ:hover,
  .section-{{ section.id }} .fx-journal__circ:focus-visible {
    background: #fff;
    color: #000;
  }
  .section-{{ section.id }} .fx-journal__track {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(18px, 2vw, 30px);
  }
  .section-{{ section.id }} .fx-jcard {
    display: flex;
    flex-direction: column;
    min-width: 0;
    background: #0c0c0e;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 14px;
    overflow: hidden;
    transition: border-color 0.3s cubic-bezier(0.4, 0, 0.2, 1), box-shadow 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .section-{{ section.id }} .fx-jcard:hover {
    border-color: var(--jl-accent);
    box-shadow: 0 24px 50px rgba(0, 0, 0, 0.5);
  }
  .section-{{ section.id }} .fx-jcard__media {
    display: block;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: #111;
  }
  .section-{{ section.id }} .fx-jcard__media img,
  .section-{{ section.id }} .fx-jcard__media .fx-jcard__placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .section-{{ section.id }} .fx-jcard__media .fx-jcard__placeholder {
    opacity: 0.4;
  }
  .section-{{ section.id }} .fx-jcard:hover .fx-jcard__media img {
    transform: scale(1.06);
  }
  .section-{{ section.id }} .fx-jcard__body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 20px 22px;
  }
  .section-{{ section.id }} .fx-jcard__meta {
    font-family: 'Outfit', 'Archivo', system-ui, sans-serif;
    font-size: 11.5px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.5);
    margin: 0 0 12px;
  }
  .section-{{ section.id }} .fx-jcard__meta em {
    font-style: normal;
    color: rgba(255, 255, 255, 0.85);
  }
  .section-{{ section.id }} .fx-jcard__title {
    font-family: 'PP Monument Extended', 'Archivo', system-ui, sans-serif;
    font-weight: 400;
    font-size: 16px;
    line-height: 1.45;
    margin: 0 0 12px;
  }
  .section-{{ section.id }} .fx-jcard__title a {
    color: #fff;
  }
  .section-{{ section.id }} .fx-jcard:hover .fx-jcard__title a {
    color: var(--jl-accent);
  }
  .section-{{ section.id }} .fx-jcard__excerpt {
    font-family: 'Outfit', 'Archivo', system-ui, sans-serif;
    font-size: 13.5px;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.55);
    margin: 0 0 18px;
  }
  .section-{{ section.id }} .fx-jcard__read {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    margin-top: auto;
    padding-top: 16px;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    font-family: 'Outfit', 'Archivo', system-ui, sans-serif;
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #fff;
  }
  .section-{{ section.id }} .fx-jcard__read svg {
    color: var(--jl-accent);
    transition: transform 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .section-{{ section.id }} .fx-jcard:hover .fx-jcard__read {
    color: var(--jl-accent);
  }
  .section-{{ section.id }} .fx-jcard:hover .fx-jcard__read svg {
    transform: translateX(4px);
  }
  .section-{{ section.id }} :is(a, button):focus-visible {
    outline: 2px solid var(--jl-accent);
    outline-offset: 2px;
  }
  @media (max-width: 1100px) {
    .section-{{ section.id }} .fx-journal__track {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      margin-inline: calc(clamp(16px, 4.4vw, 72px) * -1);
      padding-inline: clamp(16px, 4.4vw, 72px);
    }
    .section-{{ section.id }} .fx-journal__track::-webkit-scrollbar { display: none; }
    .section-{{ section.id }} .fx-jcard { flex: 0 0 min(78vw, 340px); scroll-snap-align: start; }
  }
{% endstyle %}

<script>
  (function () {
    var root = document.getElementById('{{ section.id }}');
    if (!root || root.dataset.fxInit === 'true') return;
    root.dataset.fxInit = 'true';
    var track = root.querySelector('[data-fx-journal-role="track"]');
    if (!track) return;
    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var card = track.querySelector('.fx-jcard');
    function step() { return card ? card.getBoundingClientRect().width + 24 : 320; }
    root.querySelector('[data-fx-journal-role="prev"]').addEventListener('click', function () {
      track.scrollBy({ left: -step(), behavior: reduce ? 'auto' : 'smooth' });
    });
    root.querySelector('[data-fx-journal-role="next"]').addEventListener('click', function () {
      track.scrollBy({ left: step(), behavior: reduce ? 'auto' : 'smooth' });
    });
  })();
</script>

{% schema %}
{
  "name": "FX Journal",
  "tag": "section",
  "class": "fx-journal-section",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Journal" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Science, systems, substance." },
    { "type": "blog", "id": "blog", "label": "Blog" },
    { "type": "range", "id": "posts_to_show", "label": "Articles to show", "min": 2, "max": 8, "step": 1, "default": 4 },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "accent", "label": "Accent", "default": "#3E7EA0" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 20, "max": 140, "step": 4, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 20, "max": 140, "step": 4, "unit": "px", "default": 96 }
  ],
  "presets": [
    { "name": "FX Journal" }
  ]
}
{% endschema %}
