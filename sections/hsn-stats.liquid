<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Outfit:wght@100..900&display=swap">
{% comment %}
  HSN Stats — black band with animated count-up figures.
  Settings groups: Content, Colors, Spacing, Animation. Blocks: stat.
{% endcomment %}

<div
  id="{{ section.id }}"
  class="hsn-stats section-{{ section.id }}"
  style="--st-bg: {{ section.settings.bg }}; --st-color: {{ section.settings.text_color }}; --st-accent: {{ section.settings.accent }}; --st-pt: {{ section.settings.padding_top }}px; --st-pb: {{ section.settings.padding_bottom }}px;"
  {{ section.shopify_attributes }}
>
  <div class="hsn-stats__wrap">
    {%- if section.settings.eyebrow != blank -%}
      <p class="hsn-stats__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}
    <div class="hsn-stats__grid">
      {%- for block in section.blocks -%}
        <div class="hsn-stats__item" {{ block.shopify_attributes }}>
          <b class="hsn-stats__num" data-hsn-count="{{ block.settings.number | escape }}">{{ block.settings.number | escape }}</b>
          <p class="hsn-stats__label">{{ block.settings.label | escape }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% style %}
  @font-face{font-family:'PP Monument Extended';src:url('https://cdn.shopify.com/s/files/1/0910/7564/1730/files/PPMonumentExtended-Bold.woff?v=1767889659') format('woff');font-weight:700;font-style:normal;font-display:swap}
  @font-face{font-family:'PP Monument Extended';src:url('https://cdn.shopify.com/s/files/1/0910/7564/1730/files/PPMonumentExtended-Regular.woff?v=1767889658') format('woff');font-weight:400;font-style:normal;font-display:swap}
  .section-{{ section.id }} .hsn-stats {
    background: var(--st-bg);
    color: var(--st-color);
    padding-block: var(--st-pt) var(--st-pb);
  }
  .section-{{ section.id }} .hsn-stats__wrap {
    max-width: 1400px;
    margin-inline: auto;
    padding-inline: clamp(16px, 4.4vw, 72px);
  }
  .section-{{ section.id }} .hsn-stats__eyebrow {
    text-align: center;
    font-family: 'Outfit', 'Archivo', system-ui, sans-serif;
    font-size: clamp(14px, 1.4vw, 19px);
    font-weight: 600;
    letter-spacing: 0.38em;
    text-transform: uppercase;
    color: var(--st-accent);
    margin: 0 0 clamp(28px, 3.5vw, 48px);
  }
  .section-{{ section.id }} .hsn-stats__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(20px, 2.4vw, 32px);
  }
  .section-{{ section.id }} .hsn-stats__item {
    border-top: 1px solid rgba(255, 255, 255, 0.28);
    padding-top: 26px;
  }
  .section-{{ section.id }} .hsn-stats__num {
    display: block;
    font-family: 'PP Monument Extended', 'Archivo', system-ui, sans-serif;
    font-weight: 700;
    font-size: clamp(30px, 3.6vw, 48px);
    line-height: 1;
    letter-spacing: 0.01em;
    color: #fff;
    margin-bottom: 14px;
    font-variant-numeric: tabular-nums;
  }
  .section-{{ section.id }} .hsn-stats__label {
    margin: 0;
    font-family: 'Outfit', 'Archivo', system-ui, sans-serif;
    font-size: 14.5px;
    line-height: 1.55;
    color: rgba(255, 255, 255, 0.72);
    max-width: 32ch;
  }
  @media (max-width: 900px) {
    .section-{{ section.id }} .hsn-stats__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 36px 28px; }
  }
  @media (max-width: 520px) {
    .section-{{ section.id }} .hsn-stats__grid { grid-template-columns: 1fr; }
  }
{% endstyle %}

<script>
  (function () {
    var root = document.getElementById('{{ section.id }}');
    if (!root || root.dataset.hsnInit === 'true') return;
    root.dataset.hsnInit = 'true';
    var nums = root.querySelectorAll('[data-hsn-count]');
    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!nums.length || reduce || !('IntersectionObserver' in window)) return;
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (en) {
        if (!en.isIntersecting) return;
        io.unobserve(en.target);
        var el = en.target;
        var m = el.dataset.hsnCount.match(/^(\d+)(.*)$/);
        if (!m) return;
        var end = parseInt(m[1], 10), suffix = m[2], start = null, DUR = 1400;
        el.textContent = '0' + suffix;
        function tick(ts) {
          if (start === null) start = ts;
          var t = Math.min((ts - start) / DUR, 1);
          el.textContent = Math.round(end * (1 - Math.pow(1 - t, 3))) + suffix;
          if (t < 1) requestAnimationFrame(tick);
        }
        requestAnimationFrame(tick);
      });
    }, { threshold: 0.5 });
    nums.forEach(function (el) { io.observe(el); });
  })();
</script>

{% schema %}
{
  "name": "HSN Stats",
  "tag": "section",
  "class": "hsn-stats-section",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Built Through Experience" },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "bg", "label": "Background", "default": "#000000" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#FFFFFF" },
    { "type": "color", "id": "accent", "label": "Eyebrow accent", "default": "#7EB8D4" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 20, "max": 140, "step": 4, "unit": "px", "default": 56 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 20, "max": 140, "step": 4, "unit": "px", "default": 56 }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        { "type": "text", "id": "number", "label": "Figure", "info": "Starts with a number to animate, e.g. 380% or 510K+.", "default": "7X" },
        { "type": "text", "id": "label", "label": "Label", "default": "Gut-first performance supplements, clean and functional" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "HSN Stats",
      "blocks": [
        { "type": "stat", "settings": { "number": "7X", "label": "Gut-first performance supplements, clean and functional" } },
        { "type": "stat", "settings": { "number": "4X", "label": "Up to 4x higher bioavailability with liposomal delivery" } },
        { "type": "stat", "settings": { "number": "380%", "label": "Up to 380% greater cellular uptake and absorption" } },
        { "type": "stat", "settings": { "number": "510K+", "label": "Units sold across 8 countries worldwide" } }
      ]
    }
  ]
}
{% endschema %}
