<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Outfit:wght@100..900&display=swap">
{% comment %}
  HSN Footer — link columns, newsletter, socials, wordmark, legal bar.
  Settings groups: Content, Colors, Spacing. Blocks: link column.
  Designed for the "footer" section group.
{% endcomment %}

<footer id="{{ section.id }}" class="hsn-footer section-{{ section.id }}" style="--ft-accent: {{ section.settings.accent }};" {{ section.shopify_attributes }}>
  <div class="hsn-footer__grid">
    {%- for block in section.blocks -%}
      {%- if block.type == 'link_column' -%}
        <div {{ block.shopify_attributes }}>
          <span class="hsn-footer__h">{{ block.settings.title | escape }}</span>
          <ul class="hsn-footer__list">
            {%- for link in block.settings.menu.links -%}
              <li><a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a></li>
            {%- endfor -%}
          </ul>
        </div>
      {%- elsif block.type == 'newsletter' -%}
        <div {{ block.shopify_attributes }}>
          <span class="hsn-footer__h">{{ block.settings.title | escape }}</span>
          {%- if block.settings.text != blank -%}
            <p class="hsn-footer__note">{{ block.settings.text | escape }}</p>
          {%- endif -%}
          {%- form 'customer', class: 'hsn-footer__form' -%}
            <input type="hidden" name="contact[tags]" value="newsletter">
            {%- if form.posted_successfully? -%}
              <p class="hsn-footer__msg" role="status">Welcome to the system. Check your inbox.</p>
            {%- elsif form.errors -%}
              <p class="hsn-footer__msg hsn-footer__msg--err" role="alert">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>
            {%- endif -%}
            <div class="hsn-footer__sub">
              <input
                type="email"
                name="contact[email]"
                id="hsn-news-{{ section.id }}-{{ block.id }}"
                placeholder="Your email"
                aria-label="Email address"
                autocomplete="email"
                inputmode="email"
                required
                {% if form.email %}value="{{ form.email }}"{% endif %}
              >
              <button type="submit">Join</button>
            </div>
          {%- endform -%}
          {%- if section.settings.show_socials -%}
            <div class="hsn-footer__socials">
              {%- if section.settings.social_instagram != blank -%}
                <a href="{{ section.settings.social_instagram }}" aria-label="Instagram"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3.5" y="3.5" width="17" height="17" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.2" cy="6.8" r=".9" fill="currentColor" stroke="none"/></svg></a>
              {%- endif -%}
              {%- if section.settings.social_tiktok != blank -%}
                <a href="{{ section.settings.social_tiktok }}" aria-label="TikTok"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 3v11.6a3.4 3.4 0 1 1-3.4-3.4"/><path d="M14 6.3A5 5 0 0 0 19 9.5"/></svg></a>
              {%- endif -%}
              {%- if section.settings.social_linkedin != blank -%}
                <a href="{{ section.settings.social_linkedin }}" aria-label="LinkedIn"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3.5" y="3.5" width="17" height="17" rx="3"/><path d="M8 10.6v6M8 7.5v.1M12 16.6v-3.7a2 2 0 0 1 4 0v3.7"/></svg></a>
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>

  {%- if section.settings.wordmark != blank -%}
  <div class="hsn-footer__mark">
    {{ section.settings.wordmark | image_url: width: 2400 | image_tag: widths: '800, 1400, 2000, 2400', sizes: '100vw', alt: shop.name | escape, loading: 'lazy', decoding: 'async' }}
  </div>
  {%- endif -%}

  <div class="hsn-footer__bar">
    <div class="hsn-footer__legal">
      <span>{{ section.settings.copyright | escape }}</span>
      <span class="hsn-footer__legal-links">
        {%- for link in section.settings.legal_menu.links -%}
          <a href="{{ link.url }}">{{ link.title | escape }}</a>
          {%- unless forloop.last -%}<span aria-hidden="true">&middot;</span>{%- endunless -%}
        {%- endfor -%}
      </span>
    </div>
  </div>
</footer>

{% style %}
  @font-face{font-family:'PP Monument Extended';src:url('https://cdn.shopify.com/s/files/1/0910/7564/1730/files/PPMonumentExtended-Bold.woff?v=1767889659') format('woff');font-weight:700;font-style:normal;font-display:swap}
  @font-face{font-family:'PP Monument Extended';src:url('https://cdn.shopify.com/s/files/1/0910/7564/1730/files/PPMonumentExtended-Regular.woff?v=1767889658') format('woff');font-weight:400;font-style:normal;font-display:swap}
  .section-{{ section.id }} .hsn-footer {
    background: #000;
    color: #fff;
    padding-top: clamp(52px, 6vw, 78px);
  }
  .section-{{ section.id }} .hsn-footer__grid {
    max-width: 1400px;
    margin-inline: auto;
    padding-inline: clamp(16px, 4.4vw, 72px);
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(28px, 3vw, 44px);
    padding-bottom: clamp(40px, 5vw, 64px);
    box-sizing: border-box;
  }
  .section-{{ section.id }} .hsn-footer__h {
    display: block;
    font-family: 'Outfit', 'Archivo', system-ui, sans-serif;
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #fff;
    font-weight: 750;
    margin-bottom: 30px;
  }
  .section-{{ section.id }} .hsn-footer__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .section-{{ section.id }} .hsn-footer__list li {
    margin-bottom: 20px;
  }
  .section-{{ section.id }} .hsn-footer__list li:last-child {
    margin-bottom: 0;
  }
  .section-{{ section.id }} .hsn-footer__list a {
    font-family: 'Outfit', 'Archivo', system-ui, sans-serif;
    font-size: 14px;
    color: rgba(255, 255, 255, 0.82);
    text-decoration: none;
    transition: color 0.13s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .section-{{ section.id }} .hsn-footer__list a:hover,
  .section-{{ section.id }} .hsn-footer__list a:focus-visible {
    color: var(--ft-accent);
  }
  .section-{{ section.id }} .hsn-footer__note {
    font-family: 'Outfit', 'Archivo', system-ui, sans-serif;
    font-size: 14px;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.82);
    margin: 0 0 20px;
    max-width: 29ch;
  }
  .section-{{ section.id }} .hsn-footer__sub {
    display: flex;
    max-width: 280px;
  }
  .section-{{ section.id }} .hsn-footer__sub input {
    flex: 1;
    min-width: 0;
    background: transparent;
    color: #fff;
    font: inherit;
    font-size: 14px;
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-right: 0;
    border-radius: 2px 0 0 2px;
    padding: 11px 14px;
    box-sizing: border-box;
  }
  .section-{{ section.id }} .hsn-footer__sub input::placeholder {
    color: rgba(255, 255, 255, 0.45);
  }
  .section-{{ section.id }} .hsn-footer__sub input:focus {
    outline: 0;
    border-color: var(--ft-accent);
  }
  .section-{{ section.id }} .hsn-footer__sub button {
    flex: none;
    padding: 11px 20px;
    border: 0;
    border-radius: 0 2px 2px 0;
    background: #7eb8d4;
    color: #000;
    font-family: 'Outfit', 'Archivo', system-ui, sans-serif;
    font-size: 12px;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    font-weight: 750;
    cursor: pointer;
    transition: background 0.13s cubic-bezier(0.4, 0, 0.2, 1), color 0.13s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .section-{{ section.id }} .hsn-footer__sub button:hover {
    background: #fff;
    color: #000;
  }
  .section-{{ section.id }} .hsn-footer__msg {
    font-family: 'Outfit', 'Archivo', system-ui, sans-serif;
    font-size: 13px;
    color: #7eb8d4;
    margin: 10px 0 0;
  }
  .section-{{ section.id }} .hsn-footer__msg--err {
    color: #e08a8a;
  }
  .section-{{ section.id }} .hsn-footer__socials {
    display: flex;
    gap: 16px;
    margin-top: 24px;
  }
  .section-{{ section.id }} .hsn-footer__socials a {
    width: 34px;
    height: 34px;
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-radius: 50%;
    display: grid;
    place-items: center;
    color: rgba(255, 255, 255, 0.85);
    transition: color 0.13s cubic-bezier(0.4, 0, 0.2, 1), border-color 0.13s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .section-{{ section.id }} .hsn-footer__socials a:hover,
  .section-{{ section.id }} .hsn-footer__socials a:focus-visible {
    color: var(--ft-accent);
    border-color: var(--ft-accent);
  }
  .section-{{ section.id }} .hsn-footer__mark {
    max-width: 1400px;
    margin-inline: auto;
    padding-inline: clamp(16px, 4.4vw, 72px);
    padding-top: clamp(16px, 2vw, 28px);
  }
  .section-{{ section.id }} .hsn-footer__mark img {
    display: block;
    width: 100%;
    height: auto;
  }
  .section-{{ section.id }} .hsn-footer__bar {
    background: #0e0e0e;
    margin-top: clamp(16px, 2vw, 28px);
  }
  .section-{{ section.id }} .hsn-footer__legal {
    max-width: 1400px;
    margin-inline: auto;
    padding-inline: clamp(16px, 4.4vw, 72px);
    display: flex;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    padding-block: 18px;
    font-family: 'Outfit', 'Archivo', system-ui, sans-serif;
    font-size: 12px;
    color: rgba(255, 255, 255, 0.42);
    box-sizing: border-box;
  }
  .section-{{ section.id }} .hsn-footer__legal-links a {
    color: inherit;
    text-decoration: none;
  }
  .section-{{ section.id }} .hsn-footer__legal-links a:hover,
  .section-{{ section.id }} .hsn-footer__legal-links a:focus-visible {
    color: var(--ft-accent);
  }
  .section-{{ section.id }} .hsn-footer__legal-links span {
    margin-inline: 8px;
  }
  .section-{{ section.id }} :is(a, button, input):focus-visible {
    outline: 2px solid var(--ft-accent);
    outline-offset: 2px;
  }
  @media (max-width: 880px) {
    .section-{{ section.id }} .hsn-footer__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 40px 28px; }
  }
  @media (max-width: 520px) {
    .section-{{ section.id }} .hsn-footer__grid { grid-template-columns: 1fr; gap: 34px; }
  }
{% endstyle %}

{% schema %}
{
  "name": "HSN Footer",
  "tag": "footer",
  "class": "hsn-footer-section",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "image_picker", "id": "wordmark", "label": "Wordmark image", "info": "Large logo shown above the legal bar." },
    { "type": "text", "id": "copyright", "label": "Copyright", "default": "(c) 2026 FUNCTNL. All rights reserved." },
    { "type": "link_list", "id": "legal_menu", "label": "Legal menu", "info": "Shown in the bottom bar.", "default": "footer" },
    { "type": "header", "content": "Social" },
    { "type": "checkbox", "id": "show_socials", "label": "Show social icons", "default": true },
    { "type": "url", "id": "social_instagram", "label": "Instagram" },
    { "type": "url", "id": "social_tiktok", "label": "TikTok" },
    { "type": "url", "id": "social_linkedin", "label": "LinkedIn" },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "accent", "label": "Accent", "default": "#7EB8D4" }
  ],
  "blocks": [
    {
      "type": "link_column",
      "name": "Link column",
      "settings": [
        { "type": "text", "id": "title", "label": "Column title", "default": "Shop" },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
      ]
    },
    {
      "type": "newsletter",
      "name": "Newsletter",
      "settings": [
        { "type": "text", "id": "title", "label": "Column title", "default": "Subscribe" },
        { "type": "text", "id": "text", "label": "Text", "default": "Join the system. Get product drops, science updates, and exclusive offers." }
      ]
    }
  ],
  "max_blocks": 4,
  "enabled_on": { "groups": ["footer"] }
}
{% endschema %}
