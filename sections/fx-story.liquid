{% comment %}
  FX Story — image beside a founder message.
  Settings groups: Content, Colors, Spacing.
{% endcomment %}

<div
  id="{{ section.id }}"
  class="fx-story section-{{ section.id }}"
  style="--sy-pt: {{ section.settings.padding_top }}px; --sy-pb: {{ section.settings.padding_bottom }}px; --sy-accent: {{ section.settings.accent }};"
  {{ section.shopify_attributes }}
>
  <div class="fx-story__grid">
    <div class="fx-story__media">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 1200 | image_tag: widths: '450, 600, 900, 1200', sizes: '(min-width: 901px) 46vw, 100vw', alt: section.settings.image.alt | default: section.settings.heading | strip_html | escape, loading: 'lazy', decoding: 'async' }}
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'fx-story__placeholder' }}
      {%- endif -%}
    </div>
    <div class="fx-story__body">
      {%- if section.settings.eyebrow != blank -%}
        <span class="fx-story__eyebrow">{{ section.settings.eyebrow | escape }}</span>
      {%- endif -%}
      <h2 class="fx-story__heading">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}
        <p class="fx-story__text">{{ section.settings.text | escape }}</p>
      {%- endif -%}
      {%- if section.settings.cta_label != blank -%}
        <a class="fx-story__cta" href="{{ section.settings.cta_link | default: routes.all_products_collection_url }}">
          {{ section.settings.cta_label | escape }}
          <svg width="15" height="12" viewBox="0 0 16 12" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M1 6h13M9.6 1.4 14.2 6l-4.6 4.6"/></svg>
        </a>
      {%- endif -%}
    </div>
  </div>
</div>

{% style %}
  .section-{{ section.id }} .fx-story__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.94fr) minmax(0, 1fr);
    gap: clamp(36px, 5.5vw, 90px);
    align-items: center;
    max-width: 1400px;
    margin-inline: auto;
    padding-block: var(--sy-pt) var(--sy-pb);
    padding-inline: clamp(16px, 4.4vw, 72px);
  }
  .section-{{ section.id }} .fx-story__media {
    border-radius: 10px;
    overflow: hidden;
    aspect-ratio: 4 / 4.5;
    background: #f1f1ef;
  }
  .section-{{ section.id }} .fx-story__media img,
  .section-{{ section.id }} .fx-story__media .fx-story__placeholder,
  .section-{{ section.id }} .fx-story__placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .section-{{ section.id }} .fx-story__eyebrow {
    font-family: 'Outfit', 'Archivo', system-ui, sans-serif;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--sy-accent);
    margin-bottom: 18px;
    display: block;
  }
  .section-{{ section.id }} .fx-story__heading {
    font-family: 'PP Monument Extended', 'Archivo', system-ui, sans-serif;
    font-weight: 700;
    font-size: clamp(24px, 2.7vw, 38px);
    line-height: 1.22;
    color: #000;
    margin: 0 0 24px;
    max-width: 520px;
  }
  .section-{{ section.id }} .fx-story__heading :is(em, i) {
    font-style: normal;
    color: #7eb8d4;
  }
  .section-{{ section.id }} .fx-story__text {
    font-family: 'Outfit', 'Archivo', system-ui, sans-serif;
    font-size: 15.5px;
    line-height: 1.7;
    color: #4d4d4d;
    max-width: 470px;
    margin: 0 0 36px;
    overflow-wrap: break-word;
  }
  .section-{{ section.id }} .fx-story__cta {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    background: #000;
    color: #fff;
    font-family: 'Outfit', 'Archivo', system-ui, sans-serif;
    font-size: 12px;
    line-height: 1;
    font-weight: 650;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    padding: 18px 34px;
    border-radius: 3px;
    transition: background 0.2s cubic-bezier(0.4, 0, 0.2, 1), color 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .section-{{ section.id }} .fx-story__cta:hover,
  .section-{{ section.id }} .fx-story__cta:focus-visible {
    background: #7eb8d4;
    color: #000;
  }
  @media (max-width: 900px) {
    .section-{{ section.id }} .fx-story__grid { grid-template-columns: 1fr; }
    .section-{{ section.id }} .fx-story__media { order: -1; aspect-ratio: 4 / 4.2; }
  }
{% endstyle %}

{% schema %}
{
  "name": "FX Story",
  "tag": "section",
  "class": "fx-story-section",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Why I Built FUNCTNL" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "I was tired of buying ten products to do the job of <em>one system.</em>" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Every product in the FUNCTNL range exists because it solves a real problem in a connected system. From gut health to recovery to daily output. No filler. No hype. Just what works." },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Start The System" },
    { "type": "url", "id": "cta_link", "label": "Button link" },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "accent", "label": "Accent", "default": "#7EB8D4" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 140, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 140, "step": 4, "unit": "px", "default": 124 }
  ],
  "presets": [
    { "name": "FX Story" }
  ]
}
{% endschema %}
