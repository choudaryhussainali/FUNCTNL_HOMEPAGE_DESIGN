<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Outfit:wght@100..900&display=swap">
{% comment %}
  HSN Video Reviews — heading, rating line, scroll-snap tile slider with autoplay.
  Settings groups: Content, Layout, Colors, Animation. Blocks: review tile.
{% endcomment %}

<div
  id="{{ section.id }}"
  class="hsn-vsl section-{{ section.id }}"
  style="--vr-pt: {{ section.settings.padding_top }}px; --vr-pb: {{ section.settings.padding_bottom }}px; --vr-bg: {{ section.settings.bg }}; --vr-accent: {{ section.settings.accent }};"
  {{ section.shopify_attributes }}
>
  <div class="hsn-vsl__wrap">
    <h2 class="hsn-vsl__heading">{{ section.settings.heading | escape }}</h2>
    {%- if section.settings.show_rating -%}
      <div class="hsn-vsl__rating">
        <span class="hsn-vsl__stars" aria-hidden="true">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
        <span><b>{{ section.settings.rating_value | escape }}</b> {{ section.settings.rating_text | escape }}</span>
      </div>
    {%- endif -%}
  </div>

  <div class="hsn-vsl__scroller" data-hsn-vsl-role="track" tabindex="0" aria-label="{{ section.settings.heading | escape }}">
    {%- for block in section.blocks -%}
      <div class="hsn-vsl__tile" data-hsn-tile {{ block.shopify_attributes }}>
        {%- if block.settings.link != blank -%}<a class="hsn-vsl__media" href="{{ block.settings.link }}" aria-label="{{ block.settings.alt | default: 'Customer video' | escape }}">{%- else -%}<div class="hsn-vsl__media">{%- endif -%}
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 700 | image_tag: widths: '240, 380, 500, 700', sizes: '(min-width: 1100px) 17vw, 62vw', alt: block.settings.alt | escape, loading: 'lazy', decoding: 'async' }}
          {%- else -%}
            {{ 'image' | placeholder_svg_tag: 'hsn-vsl__placeholder' }}
          {%- endif -%}
          <span class="hsn-vsl__play" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5.5v13l11-6.5z"/></svg></span>
        {%- if block.settings.link != blank -%}</a>{%- else -%}</div>{%- endif -%}
      </div>
    {%- endfor -%}
  </div>

  <div class="hsn-vsl__wrap hsn-vsl__navrow">
    <div class="hsn-vsl__nav">
      <button type="button" class="hsn-vsl__circ" data-hsn-vsl-role="prev" aria-label="Previous reviews">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 5l-7 7 7 7"/></svg>
      </button>
      <button type="button" class="hsn-vsl__circ" data-hsn-vsl-role="next" aria-label="Next reviews">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg>
      </button>
    </div>
  </div>
</div>

{% style %}
  @font-face{font-family:'PP Monument Extended';src:url('https://cdn.shopify.com/s/files/1/0910/7564/1730/files/PPMonumentExtended-Bold.woff?v=1767889659') format('woff');font-weight:700;font-style:normal;font-display:swap}
  @font-face{font-family:'PP Monument Extended';src:url('https://cdn.shopify.com/s/files/1/0910/7564/1730/files/PPMonumentExtended-Regular.woff?v=1767889658') format('woff');font-weight:400;font-style:normal;font-display:swap}
  .section-{{ section.id }} .hsn-vsl {
    background: var(--vr-bg);
    padding-block: var(--vr-pt) var(--vr-pb);
    overflow: hidden;
  }
  .section-{{ section.id }} .hsn-vsl__wrap {
    max-width: 1400px;
    margin-inline: auto;
    padding-inline: clamp(16px, 4.4vw, 72px);
    box-sizing: border-box;
  }
  .section-{{ section.id }} .hsn-vsl__heading {
    font-family: 'PP Monument Extended', 'Archivo', system-ui, sans-serif;
    font-weight: 700;
    font-size: clamp(24px, 3.2vw, 42px);
    line-height: 1.14;
    text-transform: uppercase;
    text-align: center;
    color: #000;
    margin: 0 auto 16px;
    max-width: 760px;
  }
  .section-{{ section.id }} .hsn-vsl__rating {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    flex-wrap: wrap;
    font-family: 'Outfit', 'Archivo', system-ui, sans-serif;
    font-size: 14px;
    color: #4d4d4d;
    margin-bottom: clamp(34px, 4vw, 56px);
  }
  .section-{{ section.id }} .hsn-vsl__rating b {
    color: #000;
  }
  .section-{{ section.id }} .hsn-vsl__stars {
    color: var(--vr-accent);
    letter-spacing: 2.5px;
    font-size: 15px;
  }
  .section-{{ section.id }} .hsn-vsl__scroller {
    display: flex;
    gap: 20px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    padding-inline: max(16px, calc((100vw - 1400px) / 2 + 72px));
    padding-block: 14px;
    box-sizing: border-box;
  }
  .section-{{ section.id }} .hsn-vsl__scroller::-webkit-scrollbar {
    display: none;
  }
  .section-{{ section.id }} .hsn-vsl__tile {
    flex: none;
    width: clamp(190px, 16.5vw, 236px);
    aspect-ratio: 9 / 14;
    scroll-snap-align: center;
    border-radius: 16px;
    overflow: hidden;
    background: #f1f1ef;
    transform: scale(0.94);
    transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .section-{{ section.id }} .hsn-vsl__tile.is-active {
    transform: scale(1.06);
  }
  .section-{{ section.id }} .hsn-vsl__media {
    display: block;
    position: relative;
    width: 100%;
    height: 100%;
  }
  .section-{{ section.id }} .hsn-vsl__media img,
  .section-{{ section.id }} .hsn-vsl__media .hsn-vsl__placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .section-{{ section.id }} .hsn-vsl__media .hsn-vsl__placeholder {
    width: 60%;
    height: 60%;
    margin: auto;
    position: absolute;
    inset: 0;
    opacity: 0.4;
  }
  .section-{{ section.id }} .hsn-vsl__play {
    position: absolute;
    inset: 0;
    margin: auto;
    width: 54px;
    height: 54px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.95);
    color: #000;
    display: grid;
    place-items: center;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.18);
    pointer-events: none;
  }
  .section-{{ section.id }} .hsn-vsl__navrow {
    display: flex;
    justify-content: center;
    margin-top: clamp(22px, 3vw, 34px);
  }
  .section-{{ section.id }} .hsn-vsl__nav {
    display: flex;
    gap: 14px;
  }
  .section-{{ section.id }} .hsn-vsl__circ {
    width: 46px;
    height: 46px;
    border-radius: 50%;
    border: 0;
    background: #fff;
    color: #000;
    display: grid;
    place-items: center;
    cursor: pointer;
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.1);
    transition: background 0.2s cubic-bezier(0.4, 0, 0.2, 1), color 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .section-{{ section.id }} .hsn-vsl__circ:hover,
  .section-{{ section.id }} .hsn-vsl__circ:focus-visible {
    background: #000;
    color: #fff;
  }
  .section-{{ section.id }} :is(a, button):focus-visible {
    outline: 2px solid var(--vr-accent);
    outline-offset: 2px;
  }
  @media (prefers-reduced-motion: reduce) {
    .section-{{ section.id }} .hsn-vsl__tile,
    .section-{{ section.id }} .hsn-vsl__scroller {
      scroll-behavior: auto;
      transition: none;
    }
  }
{% endstyle %}

<script>
  (function () {
    var root = document.getElementById('{{ section.id }}');
    if (!root || root.dataset.hsnInit === 'true') return;
    root.dataset.hsnInit = 'true';
    var track = root.querySelector('[data-hsn-vsl-role="track"]');
    var tiles = Array.prototype.slice.call(root.querySelectorAll('[data-hsn-tile]'));
    if (!track || !tiles.length) return;
    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    function step() { return tiles[0].getBoundingClientRect().width + 20; }
    function next() { track.scrollBy({ left: step(), behavior: reduce ? 'auto' : 'smooth' }); }
    function prev() { track.scrollBy({ left: -step(), behavior: reduce ? 'auto' : 'smooth' }); }
    root.querySelector('[data-hsn-vsl-role="next"]').addEventListener('click', function () { next(); restart(); });
    root.querySelector('[data-hsn-vsl-role="prev"]').addEventListener('click', function () { prev(); restart(); });
    var io = null;
    if ('IntersectionObserver' in window) {
      io = new IntersectionObserver(function (entries) {
        entries.forEach(function (en) {
          if (en.isIntersecting) en.target.classList.add('is-active');
          else en.target.classList.remove('is-active');
        });
      }, { root: track, threshold: 0.6 });
      tiles.forEach(function (t) { io.observe(t); });
    }
    var timer = null, autoplay = root.dataset.fxAutoplay === 'true';
    function start() {
      stop();
      if (!autoplay || reduce) return;
      timer = setInterval(next, parseInt(root.dataset.fxSpeed, 10) || 5000);
    }
    function stop() { if (timer) { clearInterval(timer); timer = null; } }
    function restart() { start(); }
    root.addEventListener('mouseenter', stop);
    root.addEventListener('mouseleave', start);
    document.addEventListener('shopify:block:select', function (e) {
      var t = e.target.closest('[data-hsn-tile]');
      if (t && root.contains(t)) t.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'nearest', inline: 'center' });
    });
    start();
  })();
</script>

{% schema %}
{
  "name": "HSN Video Reviews",
  "tag": "section",
  "class": "hsn-vsl-section",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Fueling athletes from the core" },
    { "type": "checkbox", "id": "show_rating", "label": "Show rating line", "default": true },
    { "type": "text", "id": "rating_value", "label": "Rating value", "default": "4.9" },
    { "type": "text", "id": "rating_text", "label": "Rating text", "default": "out of 5, sold world-wide" },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "bg", "label": "Background", "default": "#F4F4F2" },
    { "type": "color", "id": "accent", "label": "Accent", "default": "#3E7EA0" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 20, "max": 140, "step": 4, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 20, "max": 140, "step": 4, "unit": "px", "default": 96 },
    { "type": "header", "content": "Animation" },
    { "type": "checkbox", "id": "autoplay", "label": "Autoplay slider", "default": true },
    { "type": "range", "id": "autoplay_speed", "label": "Seconds per slide", "min": 3, "max": 10, "step": 1, "unit": "s", "default": 4 }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Video tile",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image", "info": "Portrait around 560x870 works best." },
        { "type": "text", "id": "alt", "label": "Image alt text", "default": "Customer video review" },
        { "type": "url", "id": "link", "label": "Link (optional)" }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "HSN Video Reviews",
      "blocks": [
        { "type": "review" },
        { "type": "review" },
        { "type": "review" },
        { "type": "review" }
      ]
    }
  ]
}
{% endschema %}
