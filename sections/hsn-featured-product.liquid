<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Outfit:wght@100..900&display=swap">
{% comment %}
  HSN Featured Product — single product spotlight with stat and chip blocks.
  Settings groups: Content, Layout, Colors, Spacing. Blocks: stat, chip.
{% endcomment %}

{%- liquid
  assign product = section.settings.product
  assign heading = section.settings.heading
  if heading == blank and product != blank
    assign heading = product.title
  endif
  assign body_text = section.settings.text
  if body_text == blank and product != blank
    assign body_text = product.description | strip_html | truncate: 320
  endif
-%}

<div
  id="{{ section.id }}"
  class="hsn-fprod section-{{ section.id }}"
  style="--fp-pt: {{ section.settings.padding_top }}px; --fp-pb: {{ section.settings.padding_bottom }}px; --fp-accent: {{ section.settings.accent }};"
  {{ section.shopify_attributes }}
>
  <div class="hsn-fprod__grid">
    <div class="hsn-fprod__body">
      {%- if section.settings.eyebrow != blank -%}
        <span class="hsn-fprod__eyebrow">{{ section.settings.eyebrow | escape }}</span>
      {%- endif -%}
      <h2 class="hsn-fprod__heading">{{ heading | escape }}</h2>
      {%- if section.settings.subheading != blank -%}
        <p class="hsn-fprod__subheading">{{ section.settings.subheading | escape }}</p>
      {%- endif -%}
      {%- if body_text != blank -%}
        <p class="hsn-fprod__text">{{ body_text }}</p>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <div class="hsn-fprod__stats">
          {%- for block in section.blocks -%}
            {%- if block.type == 'stat' -%}
              <div class="hsn-fprod__stat" {{ block.shopify_attributes }}>
                <b>{{ block.settings.value | escape }}</b>
                <span>{{ block.settings.label | escape }}</span>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- if product != blank -%}
        {%- form 'product', product, class: 'hsn-fprod__form' -%}
          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
          <button
            type="submit"
            class="hsn-fprod__cta"
            {% if product.available == false %}disabled{% endif %}
          >
            {%- if product.available == false -%}
              Sold out
            {%- else -%}
              {{ section.settings.cta_label | escape }}{% if product.price > 0 %} {{ product.price | money }}{% endif %}
            {%- endif -%}
          </button>
        {%- endform -%}
      {%- elsif section.settings.cta_label != blank -%}
        <a class="hsn-fprod__cta" href="{{ section.settings.cta_link | default: routes.all_products_collection_url }}">{{ section.settings.cta_label | escape }}</a>
      {%- endif -%}
    </div>

    {%- liquid
      assign img_alt = section.settings.image.alt | default: heading | strip_html | escape
      assign prod_alt = product.title | escape
    -%}
    <div class="hsn-fprod__media">
      {%- for block in section.blocks -%}
        {%- if block.type == 'chip' -%}
          <div class="hsn-fprod__chip hsn-fprod__chip--{{ block.settings.position }}" {{ block.shopify_attributes }}>
            <span>{{ block.settings.label | escape }}</span>
            <b>{{ block.settings.value | escape }}</b>
          </div>
        {%- endif -%}
      {%- endfor -%}
      <div class="hsn-fprod__ph">
        {%- if section.settings.image != blank -%}
          {{ section.settings.image | image_url: width: 1100 | image_tag: widths: '450, 600, 900, 1100', sizes: '(min-width: 901px) 46vw, 100vw', alt: img_alt, loading: 'lazy', decoding: 'async' }}
        {%- elsif product != blank and product.featured_image -%}
          {{ product.featured_image | image_url: width: 1100 | image_tag: widths: '450, 600, 900, 1100', sizes: '(min-width: 901px) 46vw, 100vw', alt: prod_alt, loading: 'lazy', decoding: 'async' }}
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag: 'hsn-fprod__placeholder' }}
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% style %}
  @font-face{font-family:'PP Monument Extended';src:url('https://cdn.shopify.com/s/files/1/0910/7564/1730/files/PPMonumentExtended-Bold.woff?v=1767889659') format('woff');font-weight:700;font-style:normal;font-display:swap}
  @font-face{font-family:'PP Monument Extended';src:url('https://cdn.shopify.com/s/files/1/0910/7564/1730/files/PPMonumentExtended-Regular.woff?v=1767889658') format('woff');font-weight:400;font-style:normal;font-display:swap}
  .section-{{ section.id }} .hsn-fprod {
    background: #fff;
    padding-block: var(--fp-pt) var(--fp-pb);
    overflow: hidden;
  }
  .section-{{ section.id }} .hsn-fprod__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    gap: clamp(36px, 5vw, 84px);
    align-items: center;
    max-width: 1400px;
    margin-inline: auto;
    padding-inline: clamp(16px, 4.4vw, 72px);
    box-sizing: border-box;
  }
  .section-{{ section.id }} .hsn-fprod__eyebrow {
    display: block;
    font-family: 'Outfit', 'Archivo', system-ui, sans-serif;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--fp-accent);
    margin-bottom: 18px;
  }
  .section-{{ section.id }} .hsn-fprod__heading {
    font-family: 'PP Monument Extended', 'Archivo', system-ui, sans-serif;
    font-weight: 700;
    font-size: clamp(30px, 3.7vw, 52px);
    line-height: 1.08;
    color: #000;
    margin: 0 0 6px;
  }
  .section-{{ section.id }} .hsn-fprod__subheading {
    font-family: 'PP Monument Extended', 'Archivo', system-ui, sans-serif;
    font-weight: 400;
    font-size: clamp(17px, 1.9vw, 26px);
    color: #7eb8d4;
    margin: 0 0 26px;
  }
  .section-{{ section.id }} .hsn-fprod__text {
    font-family: 'Outfit', 'Archivo', system-ui, sans-serif;
    font-size: 15.5px;
    line-height: 1.65;
    color: #4d4d4d;
    max-width: 470px;
    margin: 0 0 34px;
    overflow-wrap: break-word;
  }
  .section-{{ section.id }} .hsn-fprod__stats {
    display: flex;
    gap: clamp(22px, 3vw, 44px);
    flex-wrap: wrap;
    margin-bottom: 38px;
  }
  .section-{{ section.id }} .hsn-fprod__stat {
    border-left: 2px solid #7eb8d4;
    padding-inline-start: 16px;
  }
  .section-{{ section.id }} .hsn-fprod__stat b {
    display: block;
    font-family: 'PP Monument Extended', 'Archivo', system-ui, sans-serif;
    font-weight: 700;
    font-size: clamp(20px, 2.2vw, 30px);
    line-height: 1;
    color: #3e7ea0;
    margin-bottom: 7px;
  }
  .section-{{ section.id }} .hsn-fprod__stat span {
    font-family: 'Outfit', 'Archivo', system-ui, sans-serif;
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #555;
  }
  .section-{{ section.id }} .hsn-fprod__form {
    margin: 0;
  }
  .section-{{ section.id }} .hsn-fprod__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 54px;
    padding: 16px 34px;
    background: #000;
    color: #fff;
    font-family: 'Outfit', 'Archivo', system-ui, sans-serif;
    font-size: 12px;
    line-height: 1;
    font-weight: 650;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    border: 0;
    border-radius: 3px;
    cursor: pointer;
    text-decoration: none;
    transition: background 0.2s cubic-bezier(0.4, 0, 0.2, 1), color 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .section-{{ section.id }} .hsn-fprod__cta:hover:not([disabled]),
  .section-{{ section.id }} .hsn-fprod__cta:focus-visible {
    background: #7eb8d4;
    color: #000;
  }
  .section-{{ section.id }} .hsn-fprod__cta[disabled] {
    opacity: 0.45;
    cursor: not-allowed;
  }
  .section-{{ section.id }} .hsn-fprod__media {
    position: relative;
  }
  .section-{{ section.id }} .hsn-fprod__ph {
    border-radius: 10px;
    overflow: hidden;
    aspect-ratio: 4 / 4.4;
    background: #f1f1ef;
  }
  .section-{{ section.id }} .hsn-fprod__ph img,
  .section-{{ section.id }} .hsn-fprod__ph .hsn-fprod__placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .section-{{ section.id }} .hsn-fprod__ph .hsn-fprod__placeholder {
    opacity: 0.4;
  }
  .section-{{ section.id }} .hsn-fprod__chip {
    position: absolute;
    z-index: 3;
    border-radius: 8px;
    padding: 12px 16px;
    background: #000;
    color: #fff;
    box-shadow: 0 14px 34px rgba(0, 0, 0, 0.28);
    animation: hsn-fprod-float-{{ section.id }} 5.5s ease-in-out infinite;
  }
  .section-{{ section.id }} .hsn-fprod__chip span {
    display: block;
    font-family: 'Outfit', 'Archivo', system-ui, sans-serif;
    font-size: 9.5px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(126, 184, 212, 0.9);
    margin-bottom: 5px;
  }
  .section-{{ section.id }} .hsn-fprod__chip b {
    font-family: 'PP Monument Extended', 'Archivo', system-ui, sans-serif;
    font-weight: 700;
    font-size: 15px;
    line-height: 1;
  }
  .section-{{ section.id }} .hsn-fprod__chip--a { top: 7%; right: 6%; }
  .section-{{ section.id }} .hsn-fprod__chip--b { bottom: 24%; left: -4%; background: #7eb8d4; color: #000; animation-delay: 1.2s; }
  .section-{{ section.id }} .hsn-fprod__chip--b span { color: rgba(0, 0, 0, 0.6); }
  .section-{{ section.id }} .hsn-fprod__chip--c { bottom: 6%; right: 8%; animation-delay: 2.2s; }
  @keyframes hsn-fprod-float-{{ section.id }} {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-9px); }
  }
  @media (prefers-reduced-motion: reduce) {
    .section-{{ section.id }} .hsn-fprod__chip { animation: none; }
  }
  @media (max-width: 900px) {
    .section-{{ section.id }} .hsn-fprod__grid { grid-template-columns: 1fr; }
    .section-{{ section.id }} .hsn-fprod__media { order: -1; }
    .section-{{ section.id }} .hsn-fprod__chip--b { left: 2%; }
  }
{% endstyle %}

{% schema %}
{
  "name": "HSN Featured Product",
  "tag": "section",
  "class": "hsn-fprod-section",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "product", "id": "product", "label": "Product", "info": "Optional. Adds price and a working add-to-cart." },
    { "type": "image_picker", "id": "image", "label": "Image", "info": "Overrides the product image." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Featured Product" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Performer" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Creatine + Beetroot + Electrolytes" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Creatine, electrolytes and liposomal beetroot in one sachet, powered by MetaZone patented technology. 5g creatine monohydrate, 5 key electrolytes and liposomal beetroot to boost nitric oxide and blood flow. Zero sugar. Zero caffeine. One daily ritual for performance, recovery and gut health." },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Shop The Performer" },
    { "type": "url", "id": "cta_link", "label": "Button link (no product selected)" },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "accent", "label": "Accent", "default": "#3E7EA0" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 20, "max": 140, "step": 4, "unit": "px", "default": 100 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 20, "max": 140, "step": 4, "unit": "px", "default": 100 }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        { "type": "text", "id": "value", "label": "Value", "default": "5g" },
        { "type": "text", "id": "label", "label": "Label", "default": "Creatine Mono" }
      ]
    },
    {
      "type": "chip",
      "name": "Chip",
      "settings": [
        { "type": "select", "id": "position", "label": "Position", "options": [
            { "value": "a", "label": "Top right" },
            { "value": "b", "label": "Mid left (accent)" },
            { "value": "c", "label": "Bottom right" }
          ], "default": "a" },
        { "type": "text", "id": "label", "label": "Small label", "default": "Delivery" },
        { "type": "text", "id": "value", "label": "Value", "default": "Liposomal" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "HSN Featured Product",
      "blocks": [
        { "type": "stat", "settings": { "value": "5g", "label": "Creatine Mono" } },
        { "type": "stat", "settings": { "value": "654mg", "label": "Electrolytes" } },
        { "type": "stat", "settings": { "value": "0g", "label": "Sugar" } },
        { "type": "chip", "settings": { "position": "a", "label": "Delivery", "value": "Liposomal" } },
        { "type": "chip", "settings": { "position": "b", "label": "Electrolytes", "value": "654mg" } },
        { "type": "chip", "settings": { "position": "c", "label": "Caffeine", "value": "Zero" } }
      ]
    }
  ]
}
{% endschema %}
