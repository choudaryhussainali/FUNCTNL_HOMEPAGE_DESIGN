<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Outfit:wght@100..900&display=swap">
{% comment %}
  HSN Announcement — rotating announcement bar.
  Settings groups: Content, Colors, Spacing, Animation. Blocks: message.
{% endcomment %}

<div
  id="{{ section.id }}"
  class="hsn-ann section-{{ section.id }}"
  style="--ann-bg: {{ section.settings.bg }}; --ann-color: {{ section.settings.text_color }}; --ann-dot: {{ section.settings.dot_color }}; --ann-pt: {{ section.settings.padding_top }}px; --ann-pb: {{ section.settings.padding_bottom }}px;"
  {{ section.shopify_attributes }}
>
  <div class="hsn-ann__track" data-hsn-ann-role="rotator" data-hsn-speed="{{ section.settings.speed | times: 1000 }}">
    {%- for block in section.blocks -%}
      {%- liquid
        assign tag = 'span'
        if block.settings.link != blank
          assign tag = 'a'
        endif
      -%}
      <{{ tag }}
        class="hsn-ann__item{% if forloop.first %} is-active{% endif %}"
        data-hsn-index="{{ forloop.index0 }}"
        {% if block.settings.link != blank %}href="{{ block.settings.link }}"{% endif %}
        {{ block.shopify_attributes }}
      >
        {{- block.settings.text | escape -}}
      </{{ tag }}>
    {%- endfor -%}
  </div>
</div>

{% style %}
  @font-face{font-family:'PP Monument Extended';src:url('https://cdn.shopify.com/s/files/1/0910/7564/1730/files/PPMonumentExtended-Bold.woff?v=1767889659') format('woff');font-weight:700;font-style:normal;font-display:swap}
  @font-face{font-family:'PP Monument Extended';src:url('https://cdn.shopify.com/s/files/1/0910/7564/1730/files/PPMonumentExtended-Regular.woff?v=1767889658') format('woff');font-weight:400;font-style:normal;font-display:swap}
  .section-{{ section.id }} .hsn-ann {
    background: var(--ann-bg);
    color: var(--ann-color);
    text-align: center;
    padding: var(--ann-pt) 16px var(--ann-pb);
    border-bottom: 1px solid rgba(0, 0, 0, 0.1);
    overflow: hidden;
  }
  .section-{{ section.id }} .hsn-ann__track {
    display: block;
    height: 1.1em;
    font-family: 'Outfit', 'Archivo', system-ui, sans-serif;
    font-size: 12.5px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    line-height: 1.1;
  }
  .section-{{ section.id }} .hsn-ann__item {
    display: none;
  }
  .section-{{ section.id }} .hsn-ann__item.is-active {
    display: inline-block;
  }
  .section-{{ section.id }} a.hsn-ann__item {
    color: inherit;
  }
  .section-{{ section.id }} a.hsn-ann__item:hover {
    color: var(--ann-dot);
  }
  @media (prefers-reduced-motion: reduce) {
    .section-{{ section.id }} .hsn-ann__track {
      height: auto;
    }
    .section-{{ section.id }} .hsn-ann__item {
      display: block;
      padding: 3px 0;
    }
  }
{% endstyle %}

<script>
  (function () {
    var root = document.getElementById('{{ section.id }}');
    if (!root || root.dataset.hsnInit === 'true') return;
    root.dataset.hsnInit = 'true';
    var items = root.querySelectorAll('.hsn-ann__item');
    var speed = {{ section.settings.speed | times: 1000 }};
    var i = 0;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches || items.length < 2) return;
    setInterval(function () {
      items[i].classList.remove('is-active');
      i = (i + 1) % items.length;
      items[i].classList.add('is-active');
    }, speed);
  })();
</script>

{% schema %}
{
  "name": "HSN Announcement",
  "tag": "aside",
  "class": "hsn-announcement-section",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "paragraph", "content": "Messages rotate in order. Add one message per item." },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "bg", "label": "Background", "default": "#FFFFFF" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#000000" },
    { "type": "color", "id": "dot_color", "label": "Hover accent", "default": "#3E7EA0" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 4, "max": 40, "step": 2, "unit": "px", "default": 14 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 4, "max": 40, "step": 2, "unit": "px", "default": 14 },
    { "type": "header", "content": "Animation" },
    { "type": "range", "id": "speed", "label": "Seconds per message", "min": 3, "max": 10, "step": 1, "unit": "s", "default": 6 }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Subscribe & Save" },
        { "type": "url", "id": "link", "label": "Link (optional)" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "HSN Announcement",
      "blocks": [
        { "type": "message", "settings": { "text": "Subscribe & Save" } },
        { "type": "message", "settings": { "text": "30-Day Money-Back" } },
        { "type": "message", "settings": { "text": "Athlete Recommended" } },
        { "type": "message", "settings": { "text": "#NoBloating" } }
      ]
    }
  ],
  "enabled_on": { "groups": ["header"] }
}
{% endschema %}
