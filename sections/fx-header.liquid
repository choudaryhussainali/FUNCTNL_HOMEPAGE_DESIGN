{% comment %}
  FX Header — logo, navigation, search, cart, mobile drawer.
  Settings groups: Content, Colors, Layout. Loads brand fonts (PP Monument Extended + Outfit).
  Provides the page skip link. Designed for the "header" section group.
{% endcomment %}

{%- liquid
  assign font_link = ''
  if section.settings.load_fonts
    assign font_link = '<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:ital,wdth,wght@0,62..125,100..900&family=Outfit:wght@100..900&display=swap">'
  endif
-%}
{{ font_link }}

<a class="fx-header__skip" href="#MainContent">Skip to content</a>

<header id="{{ section.id }}" class="fx-header section-{{ section.id }}" style="--hd-accent: {{ section.settings.accent }};" {{ section.shopify_attributes }}>
  <div class="fx-header__in">
    <button
      type="button"
      class="fx-header__burger"
      data-fx-drawer-open
      aria-expanded="false"
      aria-controls="fx-drawer-{{ section.id }}"
      aria-label="Open menu"
    >
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M3 7h18M3 12h18M3 17h18"/></svg>
    </button>

    <a class="fx-header__logo" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">
      {%- if section.settings.logo != blank -%}
        {{ section.settings.logo | image_url: width: 360 | image_tag: widths: '180, 270, 360', sizes: '(max-width: 400px) 45vw, 180px', alt: shop.name, loading: 'eager', decoding: 'async' }}
      {%- else -%}
        <span class="fx-header__logo-text">{{ section.settings.logo_text | escape }}</span>
      {%- endif -%}
    </a>

    <nav class="fx-header__nav" aria-label="Primary">
      {%- for link in section.settings.menu.links -%}
        <a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a>
      {%- endfor -%}
    </nav>

    <div class="fx-header__actions">
      {%- if section.settings.show_search -%}
        <details class="fx-header__search">
          <summary aria-label="Search">
            <svg width="23" height="23" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.6"/><path d="M15.6 15.6 20 20"/></svg>
          </summary>
          <form action="{{ routes.search_url }}" method="get" role="search">
            <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search" aria-label="Search" autocomplete="off">
            <input type="hidden" name="type" value="product">
            <button type="submit">Go</button>
          </form>
        </details>
      {%- endif -%}

      <a class="fx-header__cart" href="{{ routes.cart_url }}" aria-label="{{ 'cart.general.title' | default: 'Cart' }} ({{ cart.item_count }})">
        <svg width="23" height="23" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" aria-hidden="true"><path d="M4.6 7.4h14.8l-1 12.4a1.2 1.2 0 0 1-1.2 1.1H6.8a1.2 1.2 0 0 1-1.2-1.1z"/><path d="M8.6 9.6V6.4a3.4 3.4 0 0 1 6.8 0v3.2"/></svg>
        {%- if cart.item_count > 0 -%}
          <span class="fx-header__cart-count" aria-hidden="true">{{ cart.item_count }}</span>
        {%- endif -%}
      </a>
    </div>
  </div>

  <div class="fx-header__overlay" data-fx-drawer-close hidden></div>
  <aside class="fx-header__drawer" id="fx-drawer-{{ section.id }}" aria-label="Menu" hidden>
    <div class="fx-header__drawer-top">
      <span class="fx-header__drawer-brand">{{ section.settings.logo_text | escape }}</span>
      <button type="button" data-fx-drawer-close aria-label="Close menu">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M5 5l14 14M19 5 5 19"/></svg>
      </button>
    </div>
    <nav aria-label="Mobile">
      {%- for link in section.settings.menu.links -%}
        <a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a>
      {%- endfor -%}
    </nav>
    <p class="fx-header__drawer-foot">#SAYNOTOBLOATING</p>
  </aside>
</header>

{% style %}
  .section-{{ section.id }}.fx-header {
    background: #000;
    color: #fff;
    position: relative;
    z-index: 40;
  }
  .section-{{ section.id }} .fx-header__skip {
    position: absolute;
    left: -9999px;
    top: 0;
    background: #fff;
    color: #000;
    padding: 10px 16px;
    z-index: 100;
    font-size: 13px;
  }
  .section-{{ section.id }} .fx-header__skip:focus-visible {
    left: 12px;
    top: 12px;
  }
  .section-{{ section.id }} .fx-header__in {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 24px;
    padding: 16px clamp(20px, 6.6vw, 90px);
  }
  .section-{{ section.id }} .fx-header__logo {
    display: inline-flex;
    align-items: center;
    justify-self: start;
    color: #fff;
  }
  .section-{{ section.id }} .fx-header__logo img {
    height: 19px;
    width: auto;
    display: block;
  }
  .section-{{ section.id }} .fx-header__logo-text {
    font-family: 'PP Monument Extended', 'Archivo', system-ui, sans-serif;
    font-weight: 700;
    font-size: 17px;
    letter-spacing: 0.02em;
  }
  .section-{{ section.id }} .fx-header__nav {
    display: flex;
    gap: clamp(20px, 3vw, 42px);
    justify-self: center;
  }
  .section-{{ section.id }} .fx-header__nav a {
    font-family: 'Outfit', 'Archivo', system-ui, sans-serif;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: #fff;
    white-space: nowrap;
    transition: color 0.13s var(--fx-eq, cubic-bezier(0.4, 0, 0.2, 1));
  }
  .section-{{ section.id }} .fx-header__nav a:hover,
  .section-{{ section.id }} .fx-header__nav a:focus-visible,
  .section-{{ section.id }} .fx-header__nav a[aria-current='page'] {
    color: var(--hd-accent);
  }
  .section-{{ section.id }} .fx-header__actions {
    display: flex;
    gap: clamp(16px, 2vw, 28px);
    align-items: center;
    justify-self: end;
  }
  .section-{{ section.id }} .fx-header__actions > * {
    color: #fff;
  }
  .section-{{ section.id }} .fx-header__burger,
  .section-{{ section.id }} .fx-header__actions summary,
  .section-{{ section.id }} .fx-header__actions button,
  .section-{{ section.id }} .fx-header__drawer button {
    min-width: 44px;
    min-height: 44px;
    display: grid;
    place-items: center;
    background: none;
    border: 0;
    cursor: pointer;
  }
  .section-{{ section.id }} .fx-header__burger {
    display: none;
    justify-self: start;
  }
  .section-{{ section.id }} .fx-header__search {
    position: relative;
  }
  .section-{{ section.id }} .fx-header__search summary {
    list-style: none;
    display: grid;
    place-items: center;
  }
  .section-{{ section.id }} .fx-header__search summary::-webkit-details-marker {
    display: none;
  }
  .section-{{ section.id }} .fx-header__search form {
    position: absolute;
    right: 0;
    top: calc(100% + 12px);
    display: flex;
    background: #fff;
    border-radius: 3px;
    overflow: hidden;
    z-index: 60;
    box-shadow: 0 14px 34px rgba(0, 0, 0, 0.25);
  }
  .section-{{ section.id }} .fx-header__search input[type='search'] {
    border: 0;
    padding: 12px 14px;
    font: inherit;
    font-size: 14px;
    color: #17171a;
    min-width: 200px;
  }
  .section-{{ section.id }} .fx-header__search button {
    background: #7eb8d4;
    color: #000;
    padding: 0 14px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .section-{{ section.id }} .fx-header__cart {
    position: relative;
    display: grid;
    place-items: center;
  }
  .section-{{ section.id }} .fx-header__cart-count {
    position: absolute;
    top: -7px;
    right: -10px;
    background: #7eb8d4;
    color: #000;
    font-size: 11px;
    min-width: 20px;
    height: 20px;
    border-radius: 999px;
    display: grid;
    place-items: center;
    padding: 0 5px;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }
  .section-{{ section.id }} .fx-header__overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.55);
    z-index: 90;
  }
  .section-{{ section.id }} .fx-header__drawer {
    position: fixed;
    top: 0;
    bottom: 0;
    left: 0;
    width: min(340px, 86vw);
    background: #000;
    color: #fff;
    z-index: 100;
    display: flex;
    flex-direction: column;
    padding: 14px 26px 34px;
    box-sizing: border-box;
  }
  .section-{{ section.id }} .fx-header__drawer-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 30px;
  }
  .section-{{ section.id }} .fx-header__drawer-brand {
    font-family: 'PP Monument Extended', 'Archivo', system-ui, sans-serif;
    font-weight: 700;
    font-size: 15px;
  }
  .section-{{ section.id }} .fx-header__drawer nav {
    display: flex;
    flex-direction: column;
  }
  .section-{{ section.id }} .fx-header__drawer nav a {
    font-family: 'PP Monument Extended', 'Archivo', system-ui, sans-serif;
    font-weight: 400;
    font-size: 16px;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: #fff;
    padding: 14px 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }
  .section-{{ section.id }} .fx-header__drawer nav a:hover {
    color: var(--hd-accent);
  }
  .section-{{ section.id }} .fx-header__drawer-foot {
    margin-top: auto;
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.5);
  }
  .section-{{ section.id }} .fx-header__drawer[hidden],
  .section-{{ section.id }} .fx-header__overlay[hidden] {
    display: none;
  }
  .section-{{ section.id }} :is(a, button, summary):focus-visible {
    outline: 2px solid var(--hd-accent);
    outline-offset: 2px;
  }
  @media (max-width: 1000px) {
    .section-{{ section.id }} .fx-header__nav {
      display: none;
    }
    .section-{{ section.id }} .fx-header__burger {
      display: grid;
    }
    .section-{{ section.id }} .fx-header__logo {
      justify-self: center;
    }
  }
{% endstyle %}

<script src="data:text/javascript,(function(){var H=document.currentScript.previousElementSibling;if(!H)return;var d=H.querySelector('.fx-header__drawer'),o=H.querySelector('.fx-header__overlay');function open(){d.hidden=false;o.hidden=false;H.querySelector('[data-fx-drawer-open]').setAttribute('aria-expanded','true');}function close(){d.hidden=true;o.hidden=true;H.querySelector('[data-fx-drawer-open]').setAttribute('aria-expanded','false');}H.addEventListener('click',function(e){if(e.target.closest('[data-fx-drawer-open]'))open();if(e.target.closest('[data-fx-drawer-close]'))close();});document.addEventListener('keydown',function(e){if(e.key==='Escape'&&!d.hidden)close();});H.addEventListener('shopify:block:select',open);H.addEventListener('shopify:block:deselect',close);})();"></script>

{% schema %}
{
  "name": "FX Header",
  "tag": "div",
  "class": "fx-header-section",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "image_picker", "id": "logo", "label": "Logo", "info": "Wordmark image, around 360px wide. Falls back to the text below." },
    { "type": "text", "id": "logo_text", "label": "Logo text fallback", "default": "FUNCTNL." },
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu" },
    { "type": "checkbox", "id": "show_search", "label": "Show search", "default": true },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "accent", "label": "Accent (hover, focus)", "default": "#7EB8D4" },
    { "type": "header", "content": "Advanced" },
    { "type": "checkbox", "id": "load_fonts", "label": "Load brand fonts (Outfit)", "info": "PP Monument Extended is always loaded from its hosted files. Disable this if your theme already loads Outfit.", "default": true }
  ],
  "enabled_on": { "groups": ["header"] }
}
{% endschema %}
